# Base URL of the Laxora billing backend API (Cloud Run URL in production).
NEXT_PUBLIC_API_URL=http://localhost:8080

# Supabase project used by Super Admin to broadcast "special reminders".
# The frontend reads the special_reminders table directly (public anon key)
# to show the notice banner/popup. Leave blank to disable the feature.
# Find these in Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
